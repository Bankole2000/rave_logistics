# Rename to ci.yml after replacing the placeholder steps with real commands (the same
# commands as the README Commands section). Add or remove app jobs to match apps/.
#
# How it works:
# - "changes" works out which apps a PR touches. A change under packages/ or to
#   root config runs every app.
# - Each app job runs only when its app changed (it shows as skipped otherwise).
# - "ci-ok" runs last and fails if any job failed or was cancelled. Make "ci-ok"
#   the ONLY required status check in branch protection: requiring the app jobs
#   directly would block PRs whose app jobs were skipped.
#
# Keeping CI fast and affordable with many apps:
# - This workflow runs on every PR, so keep it to lint, typecheck, unit tests and
#   quick builds. Run them on ubuntu-latest wherever the toolchain allows: Android,
#   most cross-platform mobile/desktop code and their unit tests do.
# - Full native builds, signing, notarization and store uploads belong in
#   release.yml, which runs only for release tags. macOS runners (needed for iOS and
#   macOS builds) are billed at a much higher rate, so avoid them here; if iOS needs
#   a compile check on PRs, run it on a schedule or only when its files change.
#
# Check for newer action major versions, and consider pinning actions to a full
# commit SHA (especially third-party ones such as dorny/paths-filter).
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  changes:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
    outputs:
      customer-web: ${{ steps.filter.outputs['customer-web'] }}
      customer-app: ${{ steps.filter.outputs['customer-app'] }}
      drivers-web: ${{ steps.filter.outputs['drivers-web'] }}
      drivers-app: ${{ steps.filter.outputs['drivers-app'] }}
      admin-app: ${{ steps.filter.outputs['admin-app'] }}
      admin-web: ${{ steps.filter.outputs['admin-web'] }}
      api: ${{ steps.filter.outputs['api'] }}
      worker: ${{ steps.filter.outputs['worker'] }}
      vendor-web: ${{ steps.filter.outputs['vendor-web'] }}
      vendor-app: ${{ steps.filter.outputs['vendor-app'] }}
      partners-api: ${{ steps.filter.outputs['partners-api'] }}
      mcp-server: ${{ steps.filter.outputs['mcp-server'] }}
      infra: ${{ steps.filter.outputs.infra }}
    steps:
      - uses: actions/checkout@v7
      - id: filter
        uses: dorny/paths-filter@v4
        with:
          # Root files that affect every app: lockfiles, workspace and tool config.
          filters: |
            shared: &shared
              - 'packages/**'
              - 'package.json'
              - 'pnpm-lock.yaml'
              - 'pnpm-workspace.yaml'
              - 'package-lock.json'
              - 'turbo.json'
              - 'Cargo.toml'
              - 'Cargo.lock'
              - 'rust-toolchain.toml'
              - '.github/workflows/ci.yml'
            customer-web:
              - *shared
              - 'apps/customer-web/**'
            customer-app:
              - *shared
              - 'apps/customer-app/**'
            drivers-web:
              - *shared
              - 'apps/drivers-web/**'
            drivers-app:
              - *shared
              - 'apps/drivers-app/**'
            admin-app:
              - *shared
              - 'apps/admin-app/**'
            admin-web:
              - *shared
              - 'apps/admin-web/**'
            api:
              - *shared
              - 'apps/api/**'
            worker:
              - *shared
              - 'apps/worker/**'
            vendor-web:
              - *shared
              - 'apps/vendor-web/**'
            vendor-app:
              - *shared
              - 'apps/vendor-app/**'
            partners-api:
              - *shared
              - 'apps/partners-api/**'
            mcp-server:
              - *shared
              - 'apps/mcp-server/**'
            infra:
              - 'infra/**'

  repo:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7
      - name: Check for unfilled template placeholders
        run: bash scripts/check-placeholders.sh
      # ubuntu-latest ships Node, which the features check needs (no dependencies).
      - name: Check features (FEATURES.md references, PRD links, generated parts)
        run: node scripts/check-features.mjs

  customer-web:
    needs: changes
    if: needs.changes.outputs['customer-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for customer-web (README Commands, "customer-web").
      - name: Fail until configured
        run: |
          echo "Replace with the customer-web app's install, lint, typecheck, test and build commands."
          exit 1

  customer-app:
    needs: changes
    if: needs.changes.outputs['customer-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only (README Commands, "customer-app").
      - name: Fail until configured
        run: |
          echo "Replace with the customer-app install, lint and test commands."
          exit 1

  drivers-web:
    needs: changes
    if: needs.changes.outputs['drivers-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for drivers-web (README Commands, "drivers-web").
      - name: Fail until configured
        run: |
          echo "Replace with the drivers-web app's install, lint, typecheck, test and build commands."
          exit 1

  drivers-app:
    needs: changes
    if: needs.changes.outputs['drivers-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only (README Commands, "drivers-app").
      - name: Fail until configured
        run: |
          echo "Replace with the drivers-app install, lint and test commands."
          exit 1

  admin-app:
    needs: changes
    if: needs.changes.outputs['admin-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS and macOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only (README Commands, "admin-app").
      - name: Fail until configured
        run: |
          echo "Replace with the admin-app install, lint and test commands."
          exit 1

  admin-web:
    needs: changes
    if: needs.changes.outputs['admin-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for admin-web (README Commands, "admin-web").
      - name: Fail until configured
        run: |
          echo "Replace with the admin-web app's install, lint, typecheck, test and build commands."
          exit 1

  api:
    needs: changes
    if: needs.changes.outputs['api'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # A database for integration tests, with trust authentication so no password sits
    # in the repository (it only listens inside the runner). Same image as docker-compose.yml.
    services:
      postgres:
        image: postgis/postgis:18-3.6
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
          POSTGRES_DB: rave
        ports: ['127.0.0.1:15482:5432']
        options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    env:
      DATABASE_URL: postgres://postgres@127.0.0.1:15482/rave
      CARGO_TERM_COLOR: always
    steps:
      - uses: actions/checkout@v7
      # Installs the toolchain pinned in rust-toolchain.toml (README Commands, "api").
      - run: rustup toolchain install
      - uses: Swatinem/rust-cache@v2
      - name: Lint
        run: |
          cargo fmt --all -- --check
          cargo clippy -p api --all-targets -- -D warnings
      - name: Test
        run: cargo test -p api
      - name: Contract is up to date
        run: cargo run -p api --bin openapi -- --out packages/api-contract/openapi.json --check
      - name: Build
        run: cargo build -p api --release

  worker:
    needs: changes
    if: needs.changes.outputs['worker'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # A database for integration tests, with trust authentication so no password sits
    # in the repository (it only listens inside the runner):
    # services:
    #   postgres:
    #     image: postgres:17
    #     env:
    #       POSTGRES_HOST_AUTH_METHOD: trust
    #     ports: ['127.0.0.1:5432:5432']
    #     options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, tests and build for worker (README Commands, "worker").
      - name: Fail until configured
        run: |
          echo "Replace with the worker install, lint, typecheck, test and build commands."
          exit 1

  vendor-web:
    needs: changes
    if: needs.changes.outputs['vendor-web'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, unit tests and build for vendor-web (README Commands, "vendor-web").
      - name: Fail until configured
        run: |
          echo "Replace with the vendor-web app's install, lint, typecheck, test and build commands."
          exit 1

  vendor-app:
    needs: changes
    if: needs.changes.outputs['vendor-app'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed iOS and macOS builds run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Lint, typecheck and unit tests only (README Commands, "vendor-app").
      - name: Fail until configured
        run: |
          echo "Replace with the vendor-app install, lint and test commands."
          exit 1

  partners-api:
    needs: changes
    if: needs.changes.outputs['partners-api'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, tests and build for partners-api (README Commands, "partners-api").
      - name: Fail until configured
        run: |
          echo "Replace with the partners-api install, lint, typecheck, test and build commands."
          exit 1

  mcp-server:
    needs: changes
    if: needs.changes.outputs['mcp-server'] == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Install, lint, typecheck, tests and build for mcp-server (README Commands, "mcp-server").
      - name: Fail until configured
        run: |
          echo "Replace with the mcp-server install, lint, typecheck, test and build commands."
          exit 1

  infra:
    needs: changes
    if: needs.changes.outputs.infra == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Format check, validate and lint the infrastructure code. A plan needs
      # read-only cloud credentials: use short-lived OIDC credentials limited to
      # reading state, never long-lived keys, and never run apply here.
      - name: Fail until configured
        run: |
          echo "Replace with the infrastructure validate and plan commands."
          exit 1

  ci-ok:
    if: always()
    needs: [changes, repo, customer-web, customer-app, drivers-web, drivers-app, admin-app, admin-web, api, worker, vendor-web, vendor-app, partners-api, mcp-server, infra]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Fail if any job failed or was cancelled
        run: |
          if ${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') }}; then
            echo "One or more jobs failed or were cancelled."
            exit 1
          fi
          echo "All jobs passed or were skipped."
