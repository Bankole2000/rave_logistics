# Repository-wide tooling only (scripts, local infrastructure such as docker compose).
# Each app has its own apps/<app>/.env.example. Never commit real secrets.
#
# Document every variable in this format:
#   # <What it is>. Required|Optional (default: <value>). Source: <where to get it>.
#   NAME=<safe example value>

# Runtime environment. Required. One of: development, test, production.
APP_ENV=development

# The local database started by docker-compose.yml, for tools that run from the repo root
# (sqlx-cli migrations and query checks). No password: the local database uses trust
# authentication and listens on 127.0.0.1 only. Use 127.0.0.1, not localhost: the port is
# published on IPv4, and trying IPv6 (::1) first can add seconds to every new connection on
# some systems. apps/api/.env has its own copy for the api and its tests.
# Optional; needed for sqlx-cli from the repo root. Source: docker-compose.yml.
DATABASE_URL=postgres://postgres@127.0.0.1:15432/rave
