# api configuration. Copy to .env for local use (`cp .env.example .env`); .env is gitignored.
# Deployed environments set these directly; secrets come from the secret store (docs/DEPLOYMENT.md)
# and are never logged.
#
# Format:
#   # <What it is>. Required|Optional (default: <value>). Source: <where to get it>.
#   NAME=<safe example value>

# PostgreSQL connection string. Required. Source: docker-compose.yml at the repo root (local);
# the secret store (deployed). The local database uses trust authentication, so it has no password.
# Use 127.0.0.1, not localhost (TECHNICAL.md, Local development). Tests (`cargo test`) create
# and drop their own temporary databases on this server.
DATABASE_URL=postgres://postgres@127.0.0.1:15482/rave

# Address and port api listens on. Optional (default: 127.0.0.1:18082). Deployed: 0.0.0.0:<port>.
API_BIND_ADDR=127.0.0.1:18082

# Allowed browser origins, comma-separated. Optional (default: the local web dev servers on
# 127.0.0.1:13001-13004 and the Tauri shells tauri://localhost, http://tauri.localhost and
# https://tauri.localhost). Deployed: every client origin of that environment.
API_CORS_ORIGINS=http://127.0.0.1:13001,http://127.0.0.1:13002,http://127.0.0.1:13003,http://127.0.0.1:13004,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Maximum database connections per api instance. Optional (default: 10).
API_DB_MAX_CONNECTIONS=10

# Seconds to wait for a free database connection before failing a request. Optional (default: 3).
API_DB_ACQUIRE_TIMEOUT_SECONDS=3

# Log format: pretty (local) or json (deployed). Optional (default: pretty).
API_LOG_FORMAT=pretty

# Log level filter, tracing-subscriber syntax. Optional (default: info).
RUST_LOG=info,api=debug,tower_http=info

# Run pending migrations when api starts. Optional (default: true). Set false where migrations
# run as a separate release step.
API_MIGRATE_ON_START=true

# --- Sign-in (ADR-008). Each limit is a setting with a default (AGENTS.md, configurable TBDs).

# Where one-time codes and staff invitations go, by SMS or email. Optional (default: console).
# console prints them to api's stderr and is for local development only: release builds refuse
# to start with it. SMS and email senders are added once the providers are chosen (PRD, open
# decisions).
AUTH_CODE_SENDER=console

# Seconds a one-time code stays valid. Optional (default: 300).
AUTH_CODE_TTL_SECONDS=300

# Wrong guesses allowed per code before it stops working. Optional (default: 5).
AUTH_CODE_MAX_ATTEMPTS=5

# Seconds before another code can be sent to the same number. Optional (default: 60).
AUTH_CODE_RESEND_SECONDS=60

# Codes allowed per phone number in any rolling hour. Optional (default: 5).
AUTH_CODE_MAX_PER_HOUR=5

# Days a session can go unused before it is signed out. Optional (default: 90).
AUTH_SESSION_IDLE_DAYS=90

# Days a staff invitation can be accepted. Optional (default: 7).
STAFF_INVITATION_DAYS=7
